/* app.wxss — 全局样式与色彩变量（鎏金 · 文艺复兴寓意牌背主题） */
page {
  /* 暗酒红 / 墨褐底，羊皮纸金字，古金点缀 */
  --bg: #140d09;
  --bg-soft: #1c100c;
  --card-bg: #1c100c;
  --ink: #EFE3C8;          /* 羊皮纸字 */
  --ink-soft: #9C8A5E;     /* 暗金灰字 */
  --line: rgba(201, 162, 39, 0.22);
  --accent: #C9A227;       /* 古金 */
  --gold-bright: #E8CE7A;
  --gold-grad: linear-gradient(135deg, #9C7A1E 0%, #E8CE7A 25%, #C9A227 50%, #F2E2A8 75%, #9C7A1E 100%);
  --heart: #E8707A;
  --diamond: #E0A55A;
  --club: #5B9B7B;
  --spade: #6B7280;

  /* —— 视觉参考层令牌（取自参考项目，已适配鎏金主题）—— */
  --ease-depth: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-return: cubic-bezier(0.445, 0.05, 0.55, 0.95);
  --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
  /* 暗色主题下的深长投影（黑调） */
  --shadow-depth: 0 30rpx 60rpx rgba(0, 0, 0, 0.6);
  --font-serif: "Songti SC", "STSong", "SimSun", Georgia, serif;
  --font-sans: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;

  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
}

.center { display: flex; align-items: center; justify-content: center; }
.col { display: flex; flex-direction: column; }
.soft { color: var(--ink-soft); }

/* 古金主按钮 */
.ai-btn {
  background: var(--gold-grad);
  color: #1a1206;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(201, 162, 39, 0.28);
}
.ai-btn.ghost {
  background: transparent;
  color: var(--gold-bright);
  border: 2rpx solid rgba(201, 162, 39, 0.5);
  box-shadow: none;
}
.ai-btn:active { opacity: 0.85; }
