/* components/drum-carousel/drum-carousel.wxss */
.drum-stage {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  perspective: 1100rpx;
}

/* 旋转体：整体略倾斜（rotateX -14deg）模拟"斜着滚动"的滚筒 */
.drum {
  position: relative;
  width: 360rpx;
  height: 504rpx;
  transform-style: preserve-3d;
  transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.drum.dragging { transition: none; }

/* 每张卡牌：绕 Y 轴均布在圆柱表面，translateZ 推出半径。
   不隐藏背面 → 三张卡在滚筒里始终都能看到（远端卡以背面朝向，呈真实滚筒感） */
.drum-card {
  position: absolute;
  top: 0; left: 0;
  width: 360rpx;
  height: 504rpx;
  isolation: isolate;
  transform-style: preserve-3d;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.5);
}
.drum-card.is-current {
  box-shadow: 0 24rpx 64rpx rgba(185, 140, 255, 0.5);
}

.dc-img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  border-radius: 24rpx;
  z-index: 1;
}
.dc-img-fg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  border-radius: 24rpx;
  pointer-events: none;
  z-index: 4;
}

/* ===========================================================
   两层金属镭射（按 card.rarity 由 wx:for 渲染；滚筒无触控，仅 idle/flow 动画流动）
   纹理 <image> 的 dataUri 来自 data/textures.js 的 getTexture：
   normal 混合、opacity 叠加（<image> 的 mix-blend 真机失效，绝不挂）；
   渐变 <view> 层可 color-dodge 优雅增强，配 opacity 兜底。
   =========================================================== */
.dc-layer {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  pointer-events: none;
}
.dc-foil-layer {
  background-size: 300% 300%;
  background-repeat: no-repeat;
}
.dc-holo-layer {
  width: 100%; height: 100%;
  display: block;
  will-change: transform;
}
/* 渐变层：idle 缓慢流动（背景位置） */
.dc-foil-layer.idleFoil { animation: idleFoil 6s ease-in-out infinite; }
/* 纹理层：流动 / 闪烁（按 item.anim 类名匹配） */
.dc-holo-layer.flow { animation: flow 6s ease-in-out infinite; }
.dc-holo-layer.twinkle { animation: twinkle 5s ease-in-out infinite; }

/* clip-frame：只镀四边环带、中央镂空（gold 等 frame 稀有度）。箔绝不遮中央文字/符号/点数。 */
.drum-card.clip-frame .dc-layer {
  clip-path: inset(0 0 86% 0), inset(86% 0 0 0), inset(0 86% 0 0), inset(0 0 0 86%);
}

@keyframes idleFoil {
  0%, 100% { background-position: 50% 50%; }
  50%      { background-position: 100% 100%; }
}
@keyframes flow {
  0%, 100% { transform: translate(0%, 0%) scale(1); }
  50%      { transform: translate(3%, -2%) scale(1.05); }
}
@keyframes twinkle {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 0.45; }
}

/* 非当前卡牌压暗，突出焦点 */
.dc-dim {
  position: absolute; inset: 0;
  background: rgba(7, 4, 17, 0.46);
  border-radius: 24rpx;
  z-index: 5;
}

.drum-dots {
  display: flex;
  gap: 14rpx;
  margin-top: 44rpx;
}
.dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  transition: transform 0.2s ease, background 0.2s ease;
}
.dot.on {
  background: #E8CE7A;
  transform: scale(1.3);
}

.drum-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #C9A2E7;
  letter-spacing: 1rpx;
}
