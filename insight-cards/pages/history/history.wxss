/* pages/history/history.wxss — 鎏金主题 */
.page { padding: 28rpx 32rpx 60rpx; }
.empty { text-align: center; color: var(--ink-soft); font-size: 28rpx; margin-top: 120rpx; line-height: 1.7; }

.item {
  background: var(--card-bg);
  border: 1rpx solid rgba(201, 162, 39, 0.22);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.35);
}
.item-head { display: flex; align-items: center; justify-content: space-between; }
/* 牌位标识改为古金，统一暗色主题 */
.item-badge {
  font-size: 32rpx; font-weight: 700;
  color: var(--gold-bright);
  letter-spacing: 1rpx;
}
.item-time { font-size: 22rpx; color: var(--ink-soft); }
.item-q { display: block; font-size: 32rpx; line-height: 1.6; margin: 16rpx 0; color: var(--ink); }
.item-note { background: #140d09; border-radius: 14rpx; padding: 18rpx; border: 1rpx solid rgba(201, 162, 39, 0.15); }
.note-label { font-size: 22rpx; color: var(--gold-bright); margin-right: 12rpx; }
.note-text { font-size: 26rpx; color: var(--ink); line-height: 1.5; }
